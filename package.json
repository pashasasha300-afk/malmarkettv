{
  "name": "malmarkettv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run seo:snapshot && tsc --noEmit && vite build && npm run seo:render && npm run seo:validate",
    "test": "node --test tests/*.test.mjs && npm run test:ui",
    "sync": "node --env-file-if-exists=.env scripts/sync.mjs",
    "health": "node --env-file-if-exists=.env scripts/health.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview:cloudflare": "wrangler dev",
    "check:connection": "node --env-file-if-exists=.env scripts/check-connection.mjs",
    "test:ui": "vitest run",
    "seo:snapshot": "node scripts/seo/snapshot.mjs",
    "seo:render": "node scripts/seo/render.mjs",
    "seo:validate": "node scripts/seo/validate.mjs",
    "seo:check-http": "node scripts/seo/check-http.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "hls.js": "^1.6.0",
    "ipaddr.js": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-globe.gl": "^2.33.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
